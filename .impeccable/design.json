      "html": "<section class=\"ds-sheet\"><h2>Invoice expectation</h2><p>Illustrative invoice expectation for interface reference.</p><dl><dt>Expected</dt><dd>0.025 ETH</dd><dt>Source</dt><dd>Ethereum Sepolia</dd></dl></section>",
      "css": ".ds-sheet{font-family:Public Sans,system-ui,sans-serif;font-size:15px;line-height:1.55;background:var(--paper,#fff);color:var(--ink,#1d3037);padding:34px 42px;border-bottom:1px solid var(--line,#d8e0e3)}.ds-sheet h2{font-size:1.1rem;font-weight:600;margin:0 0 12px}.ds-sheet p{max-width:72ch}.ds-sheet dl{display:grid;grid-template-columns:130px minmax(0,1fr);gap:9px 20px;margin:20px 0 0}.ds-sheet dt{font-size:.88rem;color:var(--muted,#53656c)}.ds-sheet dd{margin:0;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}@media(max-width:1050px){.ds-sheet{padding:30px 28px}}@media(max-width:760px){.ds-sheet{padding:28px 20px}.ds-sheet dl{grid-template-columns:95px minmax(0,1fr);gap:10px 15px}}"
