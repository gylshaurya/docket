      "css": ".ds-label{font-family:Public Sans,system-ui,sans-serif;font-size:15px;line-height:1.55;display:block;color:var(--ink,#1d3037);font-size:.88rem;font-weight:500}.ds-input{font-family:Public Sans,system-ui,sans-serif;font-size:15px;line-height:1.55;display:block;width:100%;min-height:43px;padding:10px 11px;margin-top:6px;background:white;color:var(--ink,#1d3037);border:1px solid #aebfc4;border-radius:var(--radius,6px)}.ds-input::placeholder{color:var(--muted,#53656c)}.ds-input:focus-visible{outline:3px solid var(--focus,#2479b0);outline-offset:3px}"
