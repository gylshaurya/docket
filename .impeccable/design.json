      "css": ".ds-tag{font-family:Public Sans,system-ui,sans-serif;font-size:15px;line-height:1.55;white-space:nowrap;display:inline-block;font-size:.78rem;padding:4px 9px;border:1px solid var(--line,#d8e0e3);border-radius:4px;background:var(--rail,#f0f4f5);color:var(--ink,#1d3037);font-weight:500}.ds-good{background:#e7f3ed;color:#225e40;border-color:#bcd5c5}.ds-wait{background:var(--warning-bg,#fff5e7);color:var(--warning,#8b5018);border-color:#e6d0b4}.ds-bad{background:var(--error-bg,#fff0f1);color:var(--error,#a42d38);border-color:#e8c6ca}"
