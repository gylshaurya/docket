      "css": ".ds-rail{background:var(--rail,#f0f4f5);padding:20px}.ds-record{font-family:Public Sans,system-ui,sans-serif;font-size:15px;line-height:1.55;display:block;width:100%;text-align:left;background:transparent;color:var(--ink,#1d3037);border:0;border-radius:var(--radius,6px);padding:15px 13px;cursor:pointer;transition:background .16s ease-out}.ds-record:hover{background:var(--rail,#f0f4f5)}.ds-record[aria-pressed=true],.ds-record:active{background:var(--selected,#e1eeeb)}.ds-record strong,.ds-record span{display:block;overflow-wrap:anywhere}.ds-record strong{font-size:.92rem;font-weight:600}.ds-reference{font-size:.78rem;color:var(--muted,#53656c);margin:3px 0 8px}.ds-state{font-size:.8rem;font-weight:500}.ds-record:focus-visible{outline:3px solid var(--focus,#2479b0);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-record{transition:none}}"
